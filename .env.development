# Development Environment Variables
# Next.js automatically loads this file in development mode

# App Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data File Paths
DATA_SKILLS_PATH=/public/static/dataSkills.json
DATA_PROJECTS_PATH=/public/static/dataProjects.json

# API Configuration (if needed)
# API_URL=http://localhost:3000/api
# API_TIMEOUT=5000

# Database (if needed)
# DATABASE_URL=

# Other Development Settings
NEXT_PUBLIC_ENABLE_DEBUG=true
