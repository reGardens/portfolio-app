# Production Environment Variables
# Next.js automatically loads this file in production mode

# App Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Data File Paths
DATA_SKILLS_PATH=/public/static/dataSkills.json
DATA_PROJECTS_PATH=/public/static/dataProjects.json

# API Configuration (if needed)
# API_URL=https://yourdomain.com/api
# API_TIMEOUT=10000

# Database (if needed)
# DATABASE_URL=

# Other Production Settings
NEXT_PUBLIC_ENABLE_DEBUG=false
